FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
# ignore-scripts=false so Prisma's postinstall generates the client.
RUN npm ci --ignore-scripts=false
COPY . .
ARG SOURCE_COMMIT
# The build is gated on the real test suite, at the exact source commit, so a
# red commit can never reach the runtime image. `npm run build` emits the
# Next.js static export into dist/, which the Nginx stage below serves.
RUN test -n "$SOURCE_COMMIT" && \
    GITHUB_SHA="$SOURCE_COMMIT" npm run typecheck && \
    GITHUB_SHA="$SOURCE_COMMIT" npm run lint && \
    GITHUB_SHA="$SOURCE_COMMIT" npm test && \
    GITHUB_SHA="$SOURCE_COMMIT" npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime
ARG SOURCE_COMMIT
ENV CUBARESORT_RELEASE_SHA=${SOURCE_COMMIT}
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
COPY deploy/coolify/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 deploy/coolify/check-runtime.sh /usr/local/bin/cubaresort-check-runtime
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 8080
# Exercise the actual final image before Coolify can replace a running release.
RUN set -eu; \
    sed -i 's/listen 8080;/listen 127.0.0.1:18089;/' /etc/nginx/conf.d/default.conf; \
    nginx -t; \
    nginx -g 'daemon off;' & nginx_pid=$!; \
    trap 'kill "$nginx_pid" 2>/dev/null || true' EXIT; \
    attempt=0; \
    until wget -q -T 2 -O /dev/null http://127.0.0.1:18089/healthz; do \
      attempt=$((attempt + 1)); test "$attempt" -lt 15; sleep 1; \
    done; \
    /usr/local/bin/cubaresort-check-runtime http://127.0.0.1:18089; \
    sed -i 's/listen 127.0.0.1:18089;/listen 8080;/' /etc/nginx/conf.d/default.conf
HEALTHCHECK --interval=30s --timeout=30s --start-period=15s --retries=3 \
  CMD /usr/local/bin/cubaresort-check-runtime
