# CUBARESORT.CA — environment template.
# Copy to .env.local for development. Never commit real values.
# Variable names match takatak-v1 so one Coolify operator reads both the same way.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# The TAKATAK V1 Supabase project, `cubaresort` schema — the same arrangement
# ISEXY uses with `isexy`. DATABASE_URL is the pooled connection (PgBouncer,
# port 6543); DIRECT_URL is the direct connection (port 5432) that migrations
# need. Both must carry ?schema=cubaresort.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=cubaresort&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=cubaresort"
PGSSL_REJECT_UNAUTHORIZED=true
PRISMA_POOL_MAX=5

# ── Supabase / TAKATAK AUTH ─────────────────────────────────────────────────
# Identity is TAKATAK Auth (Google sign-in + Twilio OTP), already built in
# takatak-v1. CUBARESORT does not implement its own login: it reads the session.
# SUPABASE_SECRET_KEY is server-only and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# ── Not configured yet (deliberately blank) ─────────────────────────────────
# No booking provider, no payment processor and no contact mailbox is verified.
# Leaving these empty keeps the site in information-only mode, which is the
# only legally reviewed state today. See docs/PRODUCTION_CHECKLIST.md.
CUBARESORT_CONTACT_EMAIL=
CUBARESORT_BOOKING_PROVIDER=
